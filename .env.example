# Database Configuration
POSTGRES_DB=amsterdam_properties
POSTGRES_USER=tu_usuario_postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Django Configuration
DJANGO_SECRET_KEY=tu_clave_secreta
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_ALLOW_ASYNC_UNSAFE=true

# Scraper Configuration
SCRAPER_INTERVAL_HOURS=24
FUNDA_BASE_URL=https://www.funda.nl
FUNDA_SEARCH_URL=https://www.funda.nl/en/zoeken/koop

# Scraping Limits
MAX_PAGES=1000

# Backend Django
BACKEND_API_URL=http://backend:8000/api/properties/

# Frontend
FRONTEND_URL=http://localhost:3000

# ML Pipeline Configuration
IQR_THRESHOLD=1.5
OPPORTUNITY_THRESHOLD=0.10
LOG_TRANSFORM_TARGET=1

# ML Pipeline - Paths (opcional, usar defaults si no se especifican)
# ML_DATA_DIR=/path/to/custom/data
# ML_CSV_PATH=/path/to/custom/properties.csv
# ML_OUTPUT_DIR=/path/to/custom/ml_results
# ML_MODELS_DIR=/path/to/custom/models
